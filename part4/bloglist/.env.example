# Copy this file to .env and fill in your own values.
# .env is ignored by git, so the password never ends up on GitHub.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_ADDRESS/bloglist?retryWrites=true&w=majority&appName=Cluster0
# used by "npm test": a separate database, because the tests delete everything in it
TEST_MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_ADDRESS/testBloglist?retryWrites=true&w=majority&appName=Cluster0
PORT=3003
